# Ignore everything
/*

# Allow main folders
!/src/
!/support/
!/tests/
!/include/
!/visualize
# Allow root files
!CMakeLists.txt
!.gitignore
!.clang-format
!.vscode/

# Ignore everything inside test output folders first
/tests/ex/*
/tests/im/*
/tests/cilk5/im/*
/tests/cilk5/ex/*

/tests/ex copy
/visualize/ir.json
/visualize/output.png
# # Re-allow only what you want to keep
!/tests/ex/*.cpp
!/tests/ex/*.c
!/tests/ex/*.sh
!/tests/ex/*hh
!/tests/im/*.cpp
!/tests/im/*.sh
!/tests/im/*.c
!/tests/cilk5/im/*.c
!/tests/cilk5/im/*h
!/tests/cilk5/im/*.cpp
!/tests/cilk5/ex/*.c
!/tests/cilk5/ex/*h
!/tests/cilk5/ex/*.cpp
# Simulation and build artifacts under tests/ (regenerate with the build.sh /
# run.sh scripts beside them).
/tests/systemc/**/obj_dir/
/tests/systemc/**/gen/
/tests/systemc/**/syn/
/tests/systemc/**/*.vcd
/tests/systemc/**/*.log
/tests/systemc/overlap_model
/tests/systemc/rtl/tb_wrapper
/tests/systemc/pagerank/tb_pagerank_overlap
/tests/systemc/randomwalk/tb_randomwalk_overlap
# TBB backend output trees (generated from tests/cilk5/im by run_all.sh).
/tests/cilk5/tbb/
*.bak
